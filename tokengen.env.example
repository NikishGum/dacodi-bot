# tokengen environment (FIX-9)
#
# tokengen mints binding tokens and is deliberately given ONLY the variables it
# needs — never the bot's Zoho OAuth credentials or Telegram bot token. Deploy
# this as /opt/bot/tokengen.env and point systemd/tokengen.service at it.
#
# BINDING_TOKEN_SECRET must be byte-identical to the value in the bot's .env,
# otherwise every signature it mints will be rejected. The code trims trailing
# whitespace defensively; avoid relying on that — keep the values identical.

# Shared HMAC secret for signing binding tokens (must match the bot).
BINDING_TOKEN_SECRET=

# Token validity. Must match the bot's BINDING_TOKEN_TTL so a minted token is not
# considered expired on redemption. Default 30m.
BINDING_TOKEN_TTL=30m

# Bot username used to build the t.me deep link (without the leading @).
BOT_USERNAME=

# Listen address for the internal token endpoint. Keep it loopback / internal.
TOKENGEN_ADDR=127.0.0.1:8090

# API key required in the X-API-Key header on POST /token.
TOKENGEN_API_KEY=
