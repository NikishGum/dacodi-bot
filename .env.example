# ──────────────────────────────────────────────────────────────────────────
# Конфигурация support-бота. Скопируйте в .env (локально) или установите как
# systemd EnvironmentFile (/opt/bot/.env). Процесс не стартует, если не задана
# любая обязательная (required) переменная.
# ──────────────────────────────────────────────────────────────────────────

LOG_LEVEL=info
SERVER_ADDR=127.0.0.1:8080

# Публичный HTTPS-URL за Nginx. Нужен при TELEGRAM_MODE=webhook.
PUBLIC_BASE_URL=https://bot.example.com

# ── Telegram ─────────────────────────────────────────────────────────────--
TELEGRAM_BOT_TOKEN=                 # токен @BotFather (required)
TELEGRAM_MODE=webhook               # webhook (прод) | polling (локально)
TELEGRAM_WEBHOOK_SECRET=            # required при webhook; длинная случайная строка

# ── Redis ────────────────────────────────────────────────────────────────--
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Zoho Desk (EU по умолчанию) ─────────────────────────────────────────────
ZOHO_ACCOUNTS_URL=https://accounts.zoho.eu
ZOHO_DESK_URL=https://desk.zoho.eu
ZOHO_CLIENT_ID=                     # (required)
ZOHO_CLIENT_SECRET=                 # (required)
ZOHO_REFRESH_TOKEN=                 # (required)
ZOHO_ORG_ID=                        # (required)
ZOHO_DEPT_ID=                       # (required)

# Custom-field API-имена (значения по умолчанию). cf_telegram_chat_id — на
# тикете И на аккаунте; cf_bot_* — на аккаунте.
ZOHO_CF_CHAT_ID=cf_cf_telegram_chat_id
ZOHO_CF_BOT_CLIENT_ID=cf_cf_bot_client_id
ZOHO_CF_SERVICES=cf_cf_bot_services
ZOHO_CF_PRIORITY=cf_cf_bot_priority
# Опционально: custom-field тикета для ключа идемпотентности (FIX-5). Если не
# задано — ключ генерируется, но не пишется в Zoho, дедуп тикетов выключен
# (предупреждение в логах на старте). Создайте поле в Zoho Desk вручную.
ZOHO_CF_REQUEST_ID=

# Минимальный интервал между полными сканами аккаунтов при «холодном» промахе
# кэша (FIX-1). Защищает кредиты Zoho API от незнакомцев, пишущих боту.
ZOHO_SCAN_MIN_INTERVAL=60s

ZOHO_CONTACT_EMAIL_DOMAIN=telegram.support.local

# ── Получение ответов оператора и закрытий из Zoho ──────────────────────────
# poll    — бот сам опрашивает Zoho по таймеру (НЕ нужны вебхуки Zoho).
# webhook — Zoho вызывает /zoho/webhook (нужен ZOHO_WEBHOOK_TOKEN и доступ извне).
ZOHO_SYNC_MODE=poll
# Период опроса при ZOHO_SYNC_MODE=poll (Go duration, минимум 5s). При отсутствии
# открытых тикетов опрос НЕ делает запросов к Zoho и не тратит API-кредиты.
# 30s — баланс отзывчивости и расхода; увеличьте (60s–120s) при жёстком лимите.
ZOHO_POLL_INTERVAL=30s
# Нужен только при ZOHO_SYNC_MODE=webhook: секрет вебхука Zoho -> бот.
ZOHO_WEBHOOK_TOKEN=

# ── Токены привязки (аутентификация чата) ───────────────────────────────────
BINDING_TOKEN_SECRET=               # общий HMAC-секрет, как у tokengen (required)
BINDING_TOKEN_TTL=30m               # время жизни токена (Go duration)

# ── Реестр клиентов ─────────────────────────────────────────────────────────
# Источник истины — аккаунты Zoho Desk. clients.json — опциональный bootstrap
# (тестовые/служебные чаты) по chat_id; отсутствие/пустой файл допустимы.
# В репозитории config/clients.json — только плейсхолдеры; реальные chat_id
# держите в неотслеживаемом config/clients.local.json (FIX-10).
CLIENTS_FILE=config/clients.local.json

# ── tokengen (cmd/tokengen) — выпускается ОТДЕЛЬНЫМ tokengen.env (FIX-9) ─────--
# В проде tokengen читает /opt/bot/tokengen.env (см. tokengen.env.example), а НЕ
# этот файл, чтобы не держать в его окружении секреты Zoho/Telegram. Локально
# (один .env) переменные ниже тоже работают.
BOT_USERNAME=YourSupportBot
TOKENGEN_ADDR=127.0.0.1:8090
TOKENGEN_API_KEY=                   # API-ключ эндпоинта /token (required для tokengen)
